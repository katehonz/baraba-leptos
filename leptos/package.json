{
  "name": "baraba-leptos",
  "version": "0.1.0",
  "description": "Baraba - Онлайн счетоводен софтуер",
  "scripts": {
    "build": "tailwindcss -i ./style/input.css -o ./style/output.css --minify",
    "watch": "tailwindcss -i ./style/input.css -o ./style/output.css --watch",
    "dev": "concurrently \"npm run watch\" \"trunk serve\""
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "tailwindcss": "^3.4.0",
    "concurrently": "^8.2.2"
  }
}
