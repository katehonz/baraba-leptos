# Baraba Environment Configuration
# Копирай този файл като .env и попълни стойностите

# Задължителни
SECRET_KEY_BASE=your-secret-key-here-minimum-32-chars
APP_DOMAIN=baraba.example.com

# PostgreSQL
POSTGRES_USER=baraba
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=baraba_production

# Email (опционално)
SEND_GRID_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
